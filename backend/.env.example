# MANAWA Backend Environment Variables Template (Phase 3 #9)
# Copy this file to .env and fill in your values
# NEVER commit .env to git (already in .gitignore)
# See ENV_VARS_GUIDE.md for full documentation

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REQUIRED (Must be set for production)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Database: PostgreSQL connection (Neon Cloud)
DATABASE_URL=postgresql://user:password@host:5432/manawa

# Auth: JWT secret (min 32 chars, use strong random value)
JWT_SECRET=your_very_long_random_secret_key_min_32_chars

# Environment: production or development
NODE_ENV=development

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HIGHLY RECOMMENDED (Critical for production)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# CORS: Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://app.manawa.ci

# Email: Mailjet API credentials (CRITICAL - emails)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=noreply@manawa.ci
MAILJET_FROM_NAME=MANAWA

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL (Graceful fallback if missing)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Error Tracking: Sentry (optional monitoring)
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Video Calls: Daily.co API (video conferencing feature)
DAILY_API_KEY=your_daily_api_key

# SMS: Twilio credentials (phone verification, alerts)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payments: CinetPay alternate (if not using GeniusPay)
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id

# Push Notifications: Firebase (mobile push)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Admin Security: IP whitelist (optional access control)
ADMIN_IP_WHITELIST=192.168.1.100,203.0.113.50

# Caching: Redis for sessions, user profiles, search results, analytics
# Leave empty to use in-memory fallback (not recommended for production)
REDIS_URL=redis://localhost:6379

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Q66: FULL-TEXT SEARCH (MeiliSearch)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# MeiliSearch server URL (defaults to localhost:7700 if not set)
MEILISEARCH_URL=http://localhost:7700

# MeiliSearch API key (defaults to 'masterKey' if not set)
MEILISEARCH_API_KEY=masterKey

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE REPLICATION & BACKUP (Production)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Primary database URL (read/write)
DATABASE_PRIMARY_URL=postgresql://user:password@primary.example.com:5432/manawa

# Read replicas (comma-separated, optional)
DATABASE_REPLICA_URLS=postgresql://user:password@replica1.example.com:5432/manawa,postgresql://user:password@replica2.example.com:5432/manawa

# AWS S3 Backup Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
BACKUP_S3_BUCKET=manawa-db-backups

# Backup Schedule
BACKUP_FULL_HOUR=02                    # Full backup at 02:00 UTC
BACKUP_INCREMENTAL_HOURS=6             # Incremental every 6 hours
BACKUP_RETENTION_DAYS=30               # Keep backups for 30 days

# Neon Database API (optional, for branch-based backups)
NEON_API_KEY=your_neon_api_key
NEON_PROJECT_ID=your_neon_project_id

# Admin Log Retention (days)
ADMIN_LOG_RETENTION_DAYS=90

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEPRECATED / AUTO-SET (Can ignore)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# PORT=4000  # Render auto-sets from web process
# ADMIN_PANEL_PATH=/admin  # Deprecated, use /admin hardcoded
