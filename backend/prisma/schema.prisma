generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  passwordHash           String
  firstName              String
  lastName               String
  phone                  String?
  role                   UserRole
  avatarUrl              String?
  city                   String?
  latitude               Float?
  longitude              Float?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  emailVerified          Boolean                 @default(false)
  emailVerifyCode        String?
  emailVerifyExpiry      DateTime?
  passwordResetCode      String?
  passwordResetExpiry    DateTime?
  phoneOtpCode           String?
  phoneOtpExpiry         DateTime?
  phoneVerified          Boolean                 @default(false)
  suspended              Boolean                 @default(false)
  adminLevel             String?
  adminPermissions       String? // JSON : tableau de sections autorisées, null = accès total
  adminRoleTypeId        String? // Référence à AdminRoleType (null = ADMIN/SUPER_ADMIN)
  adminRoleType          AdminRoleType?          @relation("AdminRoleTypeUsers", fields: [adminRoleTypeId], references: [id])
  adminTeamId            String?
  lastLoginAt            DateTime?
  securityQuestion       String?
  securityAnswerHash     String?
  expoPushToken          String?
  deletedAt              DateTime?
  twoFAEnabled           Boolean                 @default(false)
  twoFASecret            String?
  twoFABackupCodes       Json?
  twoFAEnabledAt         DateTime?
  follows                Follow[]
  receivedMessages       Message[]               @relation("ReceivedMessages")
  sentMessages           Message[]               @relation("SentMessages")
  referralsMade          Referral[]              @relation("ReferralsMade")
  referralsReceived      Referral[]              @relation("ReferralsReceived")
  portfolioLikes         PortfolioLike[]
  portfolioProjectLikes  PortfolioProjectLike[]
  portfolioComments      PortfolioComment[]
  professional           Professional?
  profileViews           ProfileView[]
  projects               Project[]               @relation("ClientProjects")
  reviewsWritten         Review[]                @relation("ReviewAuthor")
  clientBookings         Booking[]               @relation("ClientBookings")
  contentReports         ContentReport[]
  supportTickets         SupportTicket[]
  pushTokens             PushToken[]
  notifications          Notification[]
  disputes               Dispute[]
  refreshTokens          RefreshToken[]
  clientPackageOrders    PackageOrder[]          @relation("ClientPackageOrders")
  initiatedCalls         VideoCall[]             @relation("InitiatedCalls")
  receivedCalls          VideoCall[]             @relation("ReceivedCalls")
  packageSuspensionLogs  PackageSuspensionLog[]
  notificationPreference NotificationPreference?
  locale                 String                  @default("fr") // fr, en, es, de
  onCallSchedules        OnCallSchedule[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  status    String // 'success' or 'failed'
  ipAddress String?
  userAgent String?
  metadata  String? // JSON metadata
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([timestamp])
}

model Professional {
  id                      String              @id @default(uuid())
  userId                  String              @unique
  trade                   String
  companyName             String?
  siret                   String?
  description             String?
  yearsExperience         Int?
  hourlyRate              Float?
  decennaleVerified       Boolean             @default(false)
  decennaleDocUrl         String?
  rgeLabel                Boolean             @default(false)
  qualibatNumber          String?
  verifiedByAdmin         Boolean             @default(false)
  interventionRadiusKm    Int                 @default(30)
  averageRating           Float               @default(0)
  reviewCount             Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  idDocumentUrl           String?
  identityStatus          String              @default("NOT_SUBMITTED")
  selfieUrl               String?
  accountType             AccountType         @default(INDEPENDENT)
  cancelledMissionsCount  Int                 @default(0)
  completedMissionsCount  Int                 @default(0)
  complaintsCount         Int                 @default(0)
  employeeCount           Int?
  lastExperienceUpdate    DateTime?
  idDocumentVersoUrl      String?
  trades                  String[]            @default([])
  identityRejectionReason String?
  trialEndsAt             DateTime?
  companyCode             String?             @unique
  companyMembers          CompanyMember[]     @relation("CompanyMembers")
  memberOf                CompanyMember?      @relation("MemberOf")
  promoUsages             PromoUsage[]
  followers               Follow[]
  portfolio               PortfolioItem[]
  portfolioProjects       PortfolioProject[]  @relation("PortfolioProjects")
  user                    User                @relation(fields: [userId], references: [id])
  profileViews            ProfileView[]
  quotes                  Quote[]
  reviews                 Review[]            @relation("ReviewedProfessional")
  subscription            Subscription?
  availabilitySlots       AvailabilitySlot[]
  bookings                Booking[]
  servicePackages         ServicePackage[]
  packageOrders           PackageOrder[]
  badges                  ProfessionalBadge[]
}

model PortfolioItem {
  id             String          @id @default(uuid())
  professionalId String
  imageUrl       String
  caption        String?
  createdAt      DateTime        @default(now())
  professional   Professional    @relation(fields: [professionalId], references: [id])
  likes          PortfolioLike[]
}

model PortfolioProject {
  id             String                  @id @default(uuid())
  professionalId String
  title          String
  description    String
  tradeCategory  String
  images         PortfolioProjectImage[]
  comments       PortfolioComment[]
  likes          PortfolioProjectLike[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  professional   Professional            @relation("PortfolioProjects", fields: [professionalId], references: [id])

  @@index([professionalId, createdAt])
}

model PortfolioProjectLike {
  id                 String           @id @default(uuid())
  userId             String
  portfolioProjectId String
  createdAt          DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id])
  portfolioProject   PortfolioProject @relation(fields: [portfolioProjectId], references: [id], onDelete: Cascade)

  @@unique([userId, portfolioProjectId])
}

model PortfolioProjectImage {
  id                 String           @id @default(uuid())
  portfolioProjectId String
  imageUrl           String
  caption            String?
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  portfolioProject   PortfolioProject @relation(fields: [portfolioProjectId], references: [id], onDelete: Cascade)

  @@index([portfolioProjectId])
}

model PortfolioComment {
  id                 String             @id @default(uuid())
  portfolioProjectId String
  authorId           String
  content            String
  rating             Int?
  parentId           String?
  createdAt          DateTime           @default(now())
  portfolioProject   PortfolioProject   @relation(fields: [portfolioProjectId], references: [id], onDelete: Cascade)
  author             User               @relation(fields: [authorId], references: [id])
  parent             PortfolioComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies            PortfolioComment[] @relation("CommentReplies")

  @@index([portfolioProjectId, createdAt])
  @@index([parentId])
}

model PortfolioLike {
  id              String        @id @default(uuid())
  userId          String
  portfolioItemId String
  createdAt       DateTime      @default(now())
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([userId, portfolioItemId])
}

model ProfileView {
  id             String       @id @default(uuid())
  viewerId       String
  professionalId String
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id])
  viewer         User         @relation(fields: [viewerId], references: [id])
}

model Follow {
  id             String       @id @default(uuid())
  followerId     String
  professionalId String
  createdAt      DateTime     @default(now())
  follower       User         @relation(fields: [followerId], references: [id])
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@unique([followerId, professionalId])
}

model Project {
  id                        String         @id @default(uuid())
  clientId                  String
  title                     String
  description               String
  tradeNeeded               String
  budgetMin                 Float?
  budgetMax                 Float?
  city                      String
  latitude                  Float?
  longitude                 Float?
  status                    ProjectStatus  @default(OPEN)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  clientConfirmedCompletion Boolean        @default(false)
  proConfirmedCompletion    Boolean        @default(false)
  client                    User           @relation("ClientProjects", fields: [clientId], references: [id])
  photos                    ProjectPhoto[]
  quotes                    Quote[]
  review                    Review?
  bookings                  Booking[]
  packageOrders             PackageOrder[]
  videoCalls                VideoCall[]
}

model ProjectPhoto {
  id        String  @id @default(uuid())
  projectId String
  imageUrl  String
  project   Project @relation(fields: [projectId], references: [id])
}

model Quote {
  id             String       @id @default(uuid())
  projectId      String
  professionalId String
  amount         Float
  description    String
  status         QuoteStatus  @default(PENDING)
  pdfUrl         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  expiresAt      DateTime?
  mode           QuoteMode    @default(SIMPLE)
  parentQuoteId  String?
  validityDays   Int          @default(15)
  version        Int          @default(1)
  payments       Payment[]
  parentQuote    Quote?       @relation("QuoteRevisions", fields: [parentQuoteId], references: [id])
  revisions      Quote[]      @relation("QuoteRevisions")
  professional   Professional @relation(fields: [professionalId], references: [id])
  project        Project      @relation(fields: [projectId], references: [id])
  items          QuoteItem[]
}

model QuoteItem {
  id        String            @id @default(uuid())
  quoteId   String
  category  QuoteItemCategory @default(OTHER)
  label     String
  quantity  Float             @default(1)
  unit      String?
  unitPrice Float
  total     Float
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  quote     Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Subscription {
  id             String       @id @default(uuid())
  professionalId String       @unique
  status         String       @default("INACTIVE")
  tier           String       @default("ESSENTIEL")
  transactionId  String?
  startedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  professional   Professional @relation(fields: [professionalId], references: [id])
}

model Payment {
  id             String            @id @default(uuid())
  quoteId        String
  geniuspayRef   String?
  idempotencyKey String?           @unique
  amount         Float
  status         String // pending | succeeded | failed
  isDeposit      Boolean           @default(true)
  fees           Float             @default(0)
  netAmount      Float?
  paymentMethod  String?
  metadata       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?
  commissionPaid Boolean           @default(false)
  bankRef        String?
  reconciledAt   DateTime?
  reconciledBy   String?
  refundAmount   Float?
  refundedAt     DateTime?
  refundRef      String?
  refundNote     String?
  quote          Quote             @relation(fields: [quoteId], references: [id])
  auditLogs      PaymentAuditLog[]
  disputes       Dispute[]

  @@unique([quoteId, isDeposit])
}

model PaymentAuditLog {
  id          String   @id @default(uuid())
  paymentId   String
  fromStatus  String // statut avant le changement
  toStatus    String // statut après le changement
  reason      String? // webhook | recheck | cron | manual | amount_mismatch
  triggeredBy String? // userId si action manuelle, "system" sinon
  ipAddress   String?
  metadata    String? // JSON — données brutes GeniusPay ou info supplémentaire
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Review {
  id             String       @id @default(uuid())
  authorId       String
  professionalId String
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())
  projectId      String?      @unique
  author         User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  professional   Professional @relation("ReviewedProfessional", fields: [professionalId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])
  flags          ReviewFlag[]
}

model SupportTicket {
  id              String           @id @default(uuid())
  userId          String
  category        String
  subject         String
  status          String           @default("OPEN")
  priority        String           @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assignedTo      String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        SupportMessage[]
  user            User             @relation(fields: [userId], references: [id])
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  senderId  String
  isAdmin   Boolean       @default(false)
  content   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
}

model CompanyMember {
  id        String       @id @default(uuid())
  companyId String
  memberId  String       @unique
  joinedAt  DateTime     @default(now())
  status    String       @default("ACTIVE")
  company   Professional @relation("CompanyMembers", fields: [companyId], references: [id])
  member    Professional @relation("MemberOf", fields: [memberId], references: [id])

  @@unique([companyId, memberId])
}

model AdminRoleType {
  id          String   @id @default(uuid())
  name        String   @unique // "Modérateur", "Agent de terrain", etc.
  slug        String   @unique // "moderator", "agent-terrain" (URL-safe)
  description String?
  isBuiltIn   Boolean  @default(false) // true = MODERATOR, ANALYST, AUDITOR, SUPPORT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]           @relation("AdminRoleTypeUsers")
  permissions RolePermission[] @relation("RolePermissions")
}

model AdminTeam {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?
  permissions String? // JSON : tableau de sections autorisées, null = accès total
  preset      String? // slug prédéfini : verification | support | finance | moderation | commercial | custom
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REFUSED
  EXPIRED
  REVISED
}

enum QuoteMode {
  SIMPLE
  DETAILED
}

enum QuoteItemCategory {
  LABOUR
  MATERIALS
  OTHER
}

enum AccountType {
  INDEPENDENT
  ENTREPRISE
}

model ContentReport {
  id          String    @id @default(uuid())
  reporterId  String
  contentType String // REVIEW | COMMENT | PORTFOLIO
  contentId   String
  reason      String
  details     String?
  status      String    @default("PENDING") // PENDING | DISMISSED | REMOVED
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([status])
  @@index([contentType, contentId])
  @@index([reporterId])
}

model ReviewFlag {
  id        String   @id @default(uuid())
  reviewId  String
  flaggedBy String   @default("system")
  reason    String?
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model PushToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  platform  String // 'ANDROID' | 'iOS'
  type      String // 'FCM' | 'APNs' | 'EXPO'
  deviceId  String?
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@index([platform])
  @@index([isActive])
}

model PushTokenMigrationLog {
  id          String    @id @default(uuid())
  userId      String
  fromToken   String?
  toToken     String?
  platform    String
  status      String // 'PENDING' | 'SUCCESS' | 'FAILED'
  reason      String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String?
  title      String
  body       String?
  message    String?
  data       Json?
  read       Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([isArchived])
}

model BroadcastLog {
  id           String   @id @default(uuid())
  adminId      String
  title        String
  body         String
  target       String // 'ALL' | 'CLIENTS' | 'PROFESSIONALS' | 'USER'
  targetUserId String?
  sent         Int      @default(0)
  total        Int      @default(0)
  createdAt    DateTime @default(now())
}

model AppConfig {
  key         String   @id
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model PromoCode {
  id              String       @id @default(uuid())
  code            String       @unique
  description     String?
  discountType    String // 'PERCENT' | 'FIXED'
  discountValue   Float
  maxUses         Int?
  usedCount       Int          @default(0)
  validFrom       DateTime     @default(now())
  validUntil      DateTime?
  applicableTiers String[]     @default([])
  active          Boolean      @default(true)
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  usages          PromoUsage[]
}

model PromoUsage {
  id             String       @id @default(uuid())
  promoCodeId    String
  professionalId String
  tier           String
  originalAmount Float
  discountAmount Float
  finalAmount    Float
  usedAt         DateTime     @default(now())
  promoCode      PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@unique([promoCodeId, professionalId])
}

model Dispute {
  id           String    @id @default(uuid())
  paymentId    String
  clientId     String
  reason       String
  description  String?
  status       String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED_REFUND | RESOLVED_PARTIAL | RESOLVED_REJECTED
  refundAmount Float?
  adminNote    String?
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
  client  User    @relation(fields: [clientId], references: [id])
}

model AvailabilitySlot {
  id             String    @id @default(uuid())
  professionalId String
  type           String // 'RECURRING' | 'EXCEPTION'
  // Recurring fields
  dayOfWeek      Int? // 0=Dimanche … 6=Samedi
  startTime      String? // "08:00"
  endTime        String? // "17:00"
  // Exception fields (indisponibilité ou plage spéciale)
  date           DateTime?
  available      Boolean   @default(true) // false = indispo ce jour
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([date])
}

model Booking {
  id             String   @id @default(uuid())
  professionalId String
  clientId       String
  date           DateTime // Jour de la réservation (à minuit UTC)
  startTime      String // "09:00"
  endTime        String // "11:00"
  status         String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  note           String?
  projectId      String?
  cancelReason   String?
  cancelledBy    String? // userId qui a annulé
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id])
  client       User         @relation("ClientBookings", fields: [clientId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([professionalId])
  @@index([clientId])
  @@index([date])
}

model ServicePackage {
  id             String   @id @default(uuid())
  professionalId String
  title          String
  description    String?
  price          Float
  duration       String? // "1 jour", "2-3 jours"
  category       String? // même liste que les trades
  included       String[] @default([]) // liste de ce qui est inclus
  images         String[] @default([]) // URLs Cloudinary
  active         Boolean  @default(true)
  ordersCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional   Professional           @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  orders         PackageOrder[]
  suspensionLogs PackageSuspensionLog[]

  @@index([professionalId])
  @@index([active])
}

model ProfessionalBadge {
  id             String   @id @default(uuid())
  professionalId String
  badgeKey       String
  earnedAt       DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, badgeKey])
  @@index([professionalId])
}

model PackageOrder {
  id             String   @id @default(uuid())
  packageId      String
  clientId       String
  professionalId String
  amount         Float
  status         String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | IN_PROGRESS | COMPLETED | CANCELLED | REFUNDED
  transactionId  String?
  paymentUrl     String?
  projectId      String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  package      ServicePackage @relation(fields: [packageId], references: [id])
  client       User           @relation("ClientPackageOrders", fields: [clientId], references: [id])
  professional Professional   @relation(fields: [professionalId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])

  @@index([packageId])
  @@index([clientId])
  @@index([professionalId])
}

model PackageSuspensionLog {
  id        String   @id @default(uuid())
  packageId String
  adminId   String
  action    String // SUSPEND | REACTIVATE
  reason    String? // Raison de suspension
  createdAt DateTime @default(now())

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  admin   User           @relation(fields: [adminId], references: [id])

  @@index([packageId])
  @@index([adminId])
  @@index([createdAt])
}

model PackageSuspensionThreshold {
  id                    String   @id @default(uuid())
  category              String   @unique // électricité, plomberie, etc. ou "*" pour défaut global
  maxDisputeRatePercent Float    @default(20) // Taux de litiges max (%)
  maxPrice              Float    @default(5000000) // Prix max (FCFA)
  minPrice              Float    @default(1000) // Prix min (FCFA)
  inactiveDaysThreshold Int      @default(180) // Jours avant flag inactif
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([category])
}

model Referral {
  id          String    @id @default(uuid())
  referrerId  String // pro qui parraine (userId)
  referredId  String // pro parrainé (userId)
  code        String // code utilisé
  status      String    @default("PENDING") // PENDING | QUALIFIED | REWARDED
  rewardType  String? // 'SUBSCRIPTION_MONTH' | 'PROMO_CREDIT'
  rewardValue Float?
  qualifiedAt DateTime? // date où le filleul a complété sa 1ère mission
  rewardedAt  DateTime?
  createdAt   DateTime  @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id])
  referred User @relation("ReferralsReceived", fields: [referredId], references: [id])

  @@unique([referredId]) // un user ne peut être parrainé qu'une fois
  @@index([referrerId])
  @@index([code])
}

model VideoCall {
  id            String    @id @default(uuid())
  roomName      String    @unique
  roomUrl       String
  initiatorId   String
  participantId String
  status        String    @default("PENDING") // PENDING | ACTIVE | ENDED | MISSED
  projectId     String?
  startedAt     DateTime?
  endedAt       DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  initiator   User     @relation("InitiatedCalls", fields: [initiatorId], references: [id])
  participant User     @relation("ReceivedCalls", fields: [participantId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([initiatorId])
  @@index([participantId])
}

model RolePermission {
  id              String        @id @default(uuid())
  adminRoleTypeId String
  adminRoleType   AdminRoleType @relation("RolePermissions", fields: [adminRoleTypeId], references: [id], onDelete: Cascade)

  section   String // "reviews", "disputes", "payments", etc.
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminRoleTypeId, section])
  @@index([adminRoleTypeId])
}

model RolePermissionHistory {
  id               String @id @default(uuid())
  adminRoleTypeId  String
  changedByAdminId String

  section             String
  previousPermissions String // JSON: {"canCreate": false, "canRead": true, ...}
  newPermissions      String // JSON: {"canCreate": true, "canRead": true, ...}

  action String // "GRANT" | "REVOKE" | "ROLLBACK"
  reason String? // optional notes

  createdAt DateTime @default(now())

  @@index([adminRoleTypeId])
  @@index([changedByAdminId])
  @@index([createdAt])
}

model Webhook {
  id        String   @id @default(uuid())
  url       String
  secret    String
  events    String[] @default([]) // ["booking.created", "payment.completed", ...]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs WebhookLog[]

  @@index([isActive])
  @@index([createdAt])
}

model WebhookLog {
  id             String    @id @default(uuid())
  webhookId      String
  event          String
  payload        String // JSON payload
  status         String // "success" | "failed" | "pending"
  response       String? // Response from endpoint
  attempt        Int       @default(1)
  nextRetryAt    DateTime?
  sequence       Int       @default(0) // Q56: Sequence number pour ordre FIFO
  idempotencyKey String? // Q56: Clé d'idempotence pour déduplication
  createdAt      DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@index([status])
  @@index([createdAt])
  @@index([sequence]) // Q56: Index sur sequence pour queries
  @@index([idempotencyKey]) // Q56: Index sur idempotency key
}

// Notification Templates with versioning
model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String // e.g., "ORDER_CONFIRMED"
  type      String // e.g., "order", "payment", "message"
  language  String // "fr", "en", "es", "de"
  title     String   @db.VarChar(200)
  body      String   @db.Text
  variables Json // Array of variable names
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([name, language, version])
  @@index([name])
  @@index([isActive])
  @@index([language])
}

// User Notification Preferences
model NotificationPreference {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Json // Nested structure: { TYPE: { email: bool, push: bool, sms: bool } }
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Q77: Configuration Versioning
model ConfigVersion {
  id        String   @id @default(uuid())
  version   String   @unique // e.g., "1.0.0", "1.0.1"
  snapshot  Json // Configuration snapshot JSON
  createdAt DateTime @default(now())
  createdBy String? // Admin user ID who created this version
  tag       String? // Git tag associated with this version
  changelog String? // Changelog text describing changes
  isStable  Boolean  @default(false) // Marked as production stable version

  @@index([version])
  @@index([createdAt])
  @@index([isStable])
}

// Q78: Rollback events tracking
model RollbackEvent {
  id               String    @id @default(uuid())
  fromVersion      String // Previous version
  toVersion        String // Target version for rollback
  trigger          String // "manual" | "auto_error_spike" | "auto_latency" | "auto_memory"
  reason           String? // Detailed reason
  metrics          Json? // Error rate, latency, memory at time of rollback
  status           String    @default("INITIATED") // INITIATED | IN_PROGRESS | COMPLETED | FAILED
  completedAt      DateTime?
  triggeredBy      String? // Admin user ID or "system"
  databaseRollback Boolean   @default(false) // If true, database was also rolled back
  backupUsed       String? // Backup ID used if applicable
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([trigger])
}

// Q78: Hourly backup integrity check results
model BackupIntegrityCheck {
  id               String   @id @default(uuid())
  backupId         String // Reference to backup
  checkType        String // "FULL_BACKUP" | "INCREMENTAL" | "DATABASE" | "FILESYSTEM"
  status           String   @default("PENDING") // PENDING | SUCCESS | FAILED
  errorMessage     String?
  checksPerformed  Int      @default(0) // Number of integrity checks performed
  checksSuccessful Int      @default(0) // Number that passed
  duration         Int? // Check duration in milliseconds
  createdAt        DateTime @default(now())

  @@index([backupId])
  @@index([checkType])
  @@index([status])
  @@index([createdAt])
}

// Q78: System health metrics for rollback decisions
model SystemHealthMetric {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  errorRate     Float    @default(0) // Percentage 0-100
  latencyP95    Int      @default(0) // Milliseconds
  latencyP99    Int      @default(0)
  memoryUsage   Float    @default(0) // Percentage 0-100
  cpuUsage      Float    @default(0) // Percentage 0-100
  activeUsers   Int      @default(0)
  dbConnections Int      @default(0)
  cacheHitRate  Float    @default(0) // Percentage 0-100

  @@index([timestamp])
  @@index([errorRate])
}

// Q71: Feature Flags System
model FeatureFlag {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
  @@index([enabled])
}

// Q72: A/B Testing Framework
model Experiment {
  id                String                 @id @default(uuid())
  name              String                 @unique
  description       String?
  status            String                 @default("DRAFT") // DRAFT | ACTIVE | PAUSED | COMPLETED
  trafficPercentage Int                    @default(100) // % of users included
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  variants          ExperimentVariant[]
  assignments       ExperimentAssignment[]

  @@index([name])
  @@index([status])
}

model ExperimentVariant {
  id           String                 @id @default(uuid())
  experimentId String
  name         String // "control" | "variant_a" | "variant_b"
  weight       Int                    @default(50) // Traffic weight (% out of total)
  experiment   Experiment             @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assignments  ExperimentAssignment[]
  metrics      ExperimentMetric[]

  @@unique([experimentId, name])
  @@index([experimentId])
}

model ExperimentAssignment {
  id           String            @id @default(uuid())
  experimentId String
  variantId    String
  userId       String
  createdAt    DateTime          @default(now())
  experiment   Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant      ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, userId])
  @@index([experimentId])
  @@index([userId])
}

model ExperimentMetric {
  id         String            @id @default(uuid())
  variantId  String
  metricName String
  value      Float
  metadata   String?
  createdAt  DateTime          @default(now())
  variant    ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([metricName])
  @@index([createdAt])
}

// Q79: Custom Metrics
model CustomMetric {
  id         String   @id @default(uuid())
  name       String
  category   String // "professional" | "platform" | "payment" | "search"
  value      Float
  unit       String? // "ms" | "%" | "count" | "EUR"
  dimensions Json? // {professionalId, city, tier, ...}
  recordedAt DateTime @default(now())

  @@index([name])
  @@index([category])
  @@index([recordedAt])
}

// Q80: Event Tracking
model UserEvent {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String?
  type      String // "search" | "profile_view" | "quote_sent" | "booking_created" | "payment" | "login" | ...
  page      String?
  metadata  Json? // {query, professionalId, amount, ...}
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
}

// Q83: Cohort Analysis snapshots
model CohortSnapshot {
  id           String   @id @default(uuid())
  cohortMonth  String // "2026-10" — month of user registration
  periodMonth  String // "2026-11" — month being measured
  periodOffset Int // 0=registration month, 1=month+1, etc.
  userCount    Int
  activeCount  Int
  retainedRate Float // activeCount / userCount
  revenue      Float    @default(0)
  createdAt    DateTime @default(now())

  @@unique([cohortMonth, periodMonth])
  @@index([cohortMonth])
}

// Q84/Q85: Retention & Churn daily snapshots
model RetentionSnapshot {
  id          String   @id @default(uuid())
  date        String // "2026-11-12"
  dau         Int      @default(0) // Daily Active Users
  wau         Int      @default(0) // Weekly Active Users
  mau         Int      @default(0) // Monthly Active Users
  newUsers    Int      @default(0)
  churned     Int      @default(0) // users inactive > 30 days
  reactivated Int      @default(0) // churned users who returned
  createdAt   DateTime @default(now())

  @@unique([date])
  @@index([date])
}

// Q87: Cost Tracking
model InfraCost {
  id        String   @id @default(uuid())
  service   String // "render" | "supabase" | "redis" | "cloudinary" | "mailjet" | "twilio" | "meilisearch" | "other"
  month     String // "2026-11" — billing month
  amountEur Float // actual billed amount in EUR
  budgetEur Float? // planned budget for comparison
  unit      String? // "GB", "emails", "SMS", "req" — for unit cost calc
  quantity  Float? // actual usage quantity
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([service, month])
  @@index([month])
  @@index([service])
}

// Q88: SLA Targets
model SlaTarget {
  id          String      @id @default(uuid())
  name        String      @unique // "api_p95_latency" | "uptime" | "error_rate"
  category    String // "latency" | "availability" | "error_rate" | "throughput"
  targetValue Float // e.g. 500 (ms), 99.9 (%), 0.1 (%)
  unit        String // "ms" | "%" | "req/s"
  windowHours Int         @default(24) // evaluation window
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  breaches    SlaBreach[]

  @@index([category])
  @@index([enabled])
}

model SlaBreach {
  id            String    @id @default(uuid())
  slaTargetId   String
  measuredValue Float // actual value that breached
  breachedAt    DateTime  @default(now())
  resolvedAt    DateTime?
  durationMs    Int? // how long the breach lasted
  slaTarget     SlaTarget @relation(fields: [slaTargetId], references: [id], onDelete: Cascade)

  @@index([slaTargetId])
  @@index([breachedAt])
}

// Q89: Alert Events (history of fired alerts)
model AlertEvent {
  id             String    @id @default(uuid())
  type           String // "error_rate" | "latency" | "memory" | "cpu" | "payment_failure" | "queue_depth"
  severity       String // "INFO" | "WARN" | "CRITICAL"
  message        String
  value          Float? // triggering metric value
  threshold      Float? // threshold that was breached
  status         String    @default("OPEN") // "OPEN" | "ACKNOWLEDGED" | "RESOLVED" | "SILENCED"
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  silencedUntil  DateTime?
  channel        String? // "slack" | "email" | "pagerduty"
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

// Q90: On-Call Rotation
model OnCallSchedule {
  id        String   @id @default(uuid())
  userId    String
  startAt   DateTime
  endAt     DateTime
  timezone  String   @default("Africa/Abidjan")
  level     Int      @default(1) // 1 = primary, 2 = secondary/escalation
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([startAt])
  @@index([endAt])
  @@index([userId])
}

// Q91/Q92: Data Retention & Archival
model DataRetentionLog {
  id          String   @id @default(uuid())
  entityType  String // "User" | "Message" | "Payment" | ...
  entityId    String
  action      String // "archived" | "deleted" | "anonymized"
  reason      String // "retention_policy" | "gdpr_request" | "manual"
  triggeredBy String? // admin userId or "cron"
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

// Q93: GDPR Right to Deletion
model GdprDeletionRequest {
  id            String    @id @default(uuid())
  userId        String
  requestedBy   String // userId (self) or admin userId
  status        String    @default("PENDING") // "PENDING" | "IN_PROGRESS" | "COMPLETED" | "REJECTED"
  reason        String?
  completedAt   DateTime?
  rejectedAt    DateTime?
  rejectionNote String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Admin Session Tracking — validate JWT against database before granting access
model AdminSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenJti  String    @unique // JWT ID claim (jti) — unique identifier for this token
  createdAt DateTime  @default(now())
  expiresAt DateTime  // When this session token expires
  revokedAt DateTime? // NULL = active, NOT NULL = revoked (logout, password change, etc.)

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}
