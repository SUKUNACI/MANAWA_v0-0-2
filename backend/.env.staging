# MANAWA Backend - Staging Environment
# ======================================

NODE_ENV=staging
PORT=4000
INSTANCE_ID=1

# Database: Staging server
DATABASE_URL=postgresql://user:password@staging-db.example.com:5432/manawa_staging
DATABASE_PRIMARY_URL=postgresql://user:password@staging-db-primary.example.com:5432/manawa_staging
DATABASE_REPLICA_URLS=postgresql://user:password@staging-db-replica1.example.com:5432/manawa_staging

# Redis: Staging cluster
REDIS_URL=redis://staging-redis.example.com:6379/0

# JWT Secret (staging: strong but not prod)
JWT_SECRET=staging_jwt_secret_strong_min_32_characters_required

# CORS: Staging origins
CORS_ORIGINS=https://staging.app.manawa.ci,https://staging-admin.manawa.ci

# Email: Mailjet (staging: separate sandbox)
MAILJET_API_KEY=staging_mailjet_api_key
MAILJET_SECRET_KEY=staging_mailjet_secret_key
MAILJET_FROM_EMAIL=staging@manawa.ci
MAILJET_FROM_NAME=MANAWA Staging

# Configuration: Staging settings
CACHE_TTL=600
CONFIG_CACHE_TTL=60
POOL_SIZE=20
ALERT_THRESHOLD_ERROR_RATE=0.1
ALERT_THRESHOLD_RESPONSE_TIME=3000
QUERY_TIMEOUT=20000
REQUEST_TIMEOUT=20000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000

# Monitoring: Staging (standard)
LOG_LEVEL=info
ENABLE_DETAILED_LOGGING=false
ENABLE_REQUEST_LOGGING=true

# Optional services
SENTRY_DSN=https://key@staging.sentry.io/project
DAILY_API_KEY=staging_daily_api_key
TWILIO_ACCOUNT_SID=AC_STAGING_ID
TWILIO_AUTH_TOKEN=staging_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"manawa-staging"}
ADMIN_IP_WHITELIST=

# Workers: Staging (moderate)
WORKERS=4

# MeiliSearch: Staging
MEILISEARCH_URL=https://meilisearch-staging.example.com
MEILISEARCH_API_KEY=staging_meilisearch_api_key

# S3 Backups: Staging
AWS_ACCESS_KEY_ID=staging_aws_key
AWS_SECRET_ACCESS_KEY=staging_aws_secret
AWS_REGION=eu-west-1
BACKUP_S3_BUCKET=manawa-db-backups-staging

# Backup schedule (staging: daily)
BACKUP_FULL_HOUR=03
BACKUP_INCREMENTAL_HOURS=6
BACKUP_RETENTION_DAYS=14

# Admin Log Retention
ADMIN_LOG_RETENTION_DAYS=60
