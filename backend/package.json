{
  "name": "manawa-backend",
  "version": "1.0.2-v1",
  "description": "API backend pour MANAWA - mise en relation particuliers/professionnels du bâtiment",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand",
    "test:e2e": "jest --config=tests/e2e/jest.config.js --runInBand --forceExit",
    "test:e2e:watch": "jest --config=tests/e2e/jest.config.js --watch",
    "test:e2e:coverage": "jest --config=tests/e2e/jest.config.js --runInBand --forceExit --coverage",
    "test:e2e:debug": "node --inspect-brk node_modules/.bin/jest --config=tests/e2e/jest.config.js --runInBand --forceExit",
    "test:all": "npm run test && npm run test:e2e",
    "audit": "scripts/audit.sh",
    "audit:fix": "scripts/audit.sh --fix",
    "audit:html": "scripts/audit.sh --html",
    "audit:critical": "scripts/audit.sh --level=critical",
    "minify": "node scripts/minify.js",
    "minify:watch": "watch 'npm run minify' public/admin"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^10.67.0",
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.0",
    "file-type": "^22.0.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.3",
    "meilisearch": "^0.43.0",
    "multer": "^2.5.0",
    "node-mailjet": "^6.0.11",
    "pdfkit": "^0.15.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "redis": "^6.3.1",
    "socket.io": "^4.7.5",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^5.2.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "chai": "^6.3.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^5.18.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^11.0.8",
    "glob": "^14.0.5",
    "rimraf": "^6.1.3",
    "uuid": "^11.1.1"
  }
}
