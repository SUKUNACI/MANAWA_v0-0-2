# MANAWA Backend - Development Environment
# ============================================

NODE_ENV=development
PORT=4000
INSTANCE_ID=1

# Database: Local PostgreSQL (or Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manawa_dev
DATABASE_PRIMARY_URL=postgresql://postgres:postgres@localhost:5432/manawa_dev
DATABASE_REPLICA_URLS=

# Redis: Local or Docker
REDIS_URL=redis://localhost:6379/0

# JWT Secret (dev: can be simple)
JWT_SECRET=dev_jwt_secret_min_32_chars_for_testing_only

# CORS: Development origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Email: Mailjet (dev: can use sandbox)
MAILJET_API_KEY=dev_mailjet_api_key
MAILJET_SECRET_KEY=dev_mailjet_secret_key
MAILJET_FROM_EMAIL=dev@manawa.ci
MAILJET_FROM_NAME=MANAWA Dev

# Configuration: Development settings
CACHE_TTL=300
CONFIG_CACHE_TTL=60
POOL_SIZE=5
ALERT_THRESHOLD_ERROR_RATE=0.5
ALERT_THRESHOLD_RESPONSE_TIME=5000
QUERY_TIMEOUT=30000
REQUEST_TIMEOUT=30000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Monitoring: Development (less strict)
LOG_LEVEL=debug
ENABLE_DETAILED_LOGGING=true
ENABLE_REQUEST_LOGGING=true

# Optional: Email, SMS, Firebase (dev: can omit)
SENTRY_DSN=
DAILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_SERVICE_ACCOUNT=
ADMIN_IP_WHITELIST=

# Workers: Development (fewer workers)
WORKERS=2

# MeiliSearch: Local
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# S3 Backups (optional for dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BACKUP_S3_BUCKET=manawa-db-backups-dev

# Backup schedule (dev: less frequent)
BACKUP_FULL_HOUR=02
BACKUP_INCREMENTAL_HOURS=12
BACKUP_RETENTION_DAYS=7

# Admin Log Retention
ADMIN_LOG_RETENTION_DAYS=30
