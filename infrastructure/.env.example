# Environment Configuration for MANAWA Infrastructure
# Copy to .env and fill in your actual values

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@postgres:5432/manawa
POSTGRES_DB=manawa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here

# ===== REDIS =====
REDIS_URL=redis://redis:6379/0

# ===== APPLICATION =====
NODE_ENV=production
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
PORT=4000
WORKERS=2

# ===== CORS & ORIGINS =====
CORS_ORIGINS=https://app.manawa.app,https://web.manawa.app,https://admin.manawa.app

# ===== ERROR TRACKING =====
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id

# ===== EMAIL SERVICE =====
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key

# ===== PUSH NOTIFICATIONS =====
FIREBASE_PROJECT_ID=your-firebase-project-id

# ===== SMS SERVICE =====
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===== IMAGE HOSTING =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key

# ===== PAYMENTS =====
STRIPE_API_KEY=your-stripe-api-key
GENIUSPAY_API_KEY=your-geniuspay-api-key

# ===== ADMIN CONFIGURATION =====
ADMIN_PANEL_PATH=/admin
ADMIN_LOG_RETENTION_DAYS=90

# ===== SCALING & PERFORMANCE =====
MAX_REQUEST_SIZE=100mb
SESSION_TIMEOUT=86400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000

# ===== DEPLOYMENT =====
RENDER_DEPLOYMENT_REGION=singapore
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
